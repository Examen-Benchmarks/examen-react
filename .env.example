# Copy to .env.dev (loaded by `npm run dev`, which runs `vite --mode dev`).

# API base URL the browser calls. In dev this is the Vite proxy prefix
# ("/api"), which forwards to BACKEND_ORIGIN below. Set to the real API
# origin when deployed.
VITE_API_BASE_URL=/api

# Request timeout (ms) for the data layer.
VITE_API_TIMEOUT_MS=30000

# Dev only: where the Vite dev-server proxy forwards "/api/*" (the Go backend).
# No VITE_ prefix → read only by vite.config, never shipped to the client.
BACKEND_ORIGIN=http://localhost:8080
